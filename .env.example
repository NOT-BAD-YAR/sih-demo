# ---- PostgreSQL ----
POSTGRES_USER=ueba
POSTGRES_PASSWORD=ueba_secret
POSTGRES_DB=ueba
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql+psycopg2://ueba:ueba_secret@localhost:5432/ueba

# ---- Kafka ----
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_GROUP_ID=analytics-engine

# ---- Behavioural baselines (Phase 4A) ----
WARMUP_DAYS=14
PRIMARY_WINDOW_DAYS=30
LONG_TERM_DAYS=90

# ---- Rule engine thresholds (Phase 4B) ----
RULE_VOLUME_THRESHOLD_K=5.0
IMPOSSIBLE_TRAVEL_SPEED_KMH=600.0
DORMANT_DAYS=30

# ---- ML anomaly detection (Phase 4C) ----
ML_MIN_WINDOWS=20
ML_CONTAMINATION=0.01
ML_N_ESTIMATORS=100

# ---- Risk bands (Phase 4D) ----
RISK_BAND_HIGH=50
RISK_BAND_CRITICAL=75

# ---- Feature flags (used by evaluation/ablation in Phase 9) ----
ENABLE_RULES=true
ENABLE_ML=true