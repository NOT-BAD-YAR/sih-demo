# ---- PostgreSQL ----
POSTGRES_USER=ueba
POSTGRES_PASSWORD=ueba_secret
POSTGRES_DB=ueba
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql+psycopg2://ueba:ueba_secret@localhost:5432/ueba

# ---- Kafka ----
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_GROUP_ID=analytics-engine

# ---- Behavioural baselines (Phase 4A) ----
WARMUP_DAYS=14
PRIMARY_WINDOW_DAYS=30
LONG_TERM_DAYS=90

# ---- Rule engine thresholds (Phase 4B) ----
RULE_VOLUME_THRESHOLD_K=5.0
IMPOSSIBLE_TRAVEL_SPEED_KMH=600.0
DORMANT_DAYS=30

# ---- ML anomaly detection (Phase 4C) ----
ML_MIN_WINDOWS=20
ML_CONTAMINATION=0.01
ML_N_ESTIMATORS=100

# ---- Risk bands (Phase 4D) ----
RISK_BAND_HIGH=50
RISK_BAND_CRITICAL=75

# ---- Feature flags (used by evaluation/ablation in Phase 9) ----
ENABLE_RULES=true
ENABLE_ML=true

# ---- start-all.bat launcher ----
# 1 = run/start this step, 0 = skip. Missing keys default to ON.
# To stop the auto seeder / auto simulation in real-time runs:
#   LAUNCHER_RUN_SEED=0
#   LAUNCHER_RUN_LIVE_DEMO=0
#   LAUNCHER_AGENT_MODE=none
LAUNCHER_START_DOCKER=1
LAUNCHER_START_CONTAINERS=1
LAUNCHER_RUN_MIGRATE=1
LAUNCHER_RUN_SEED=1
LAUNCHER_RUN_LIVE_DEMO=0
LAUNCHER_START_BACKEND=1
LAUNCHER_START_FRONTEND=1
LAUNCHER_OPEN_BROWSER=1
LAUNCHER_INSTALL_NODE_DEPS=1
LAUNCHER_AGENT_MODE=none

# ---- Windows Agent (Phase 8) ----
AGENT_READERS=security_log,sysmon,file_watcher,usb,process
AGENT_WATCH_DIRS=C:\Users
AGENT_FILE_EXTS=.xlsx,.docx,.pdf,.zip,.csv,.db
AGENT_POLL_INTERVAL_SEC=5.0
AGENT_BATCH_SIZE=50
AGENT_FLUSH_INTERVAL_SEC=5.0
AGENT_KAFKA_BOOTSTRAP=localhost:9092
AGENT_MAX_ERRORS=5
AGENT_HOSTNAME=